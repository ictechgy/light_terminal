        "cargo test --bin lterm extract_urls_skips_raw_candidates_over_length_before_trimming",
        "cargo test --bin lterm extract_urls_caps_unique_rows_but_keeps_newest_valid_last",
        "cargo test --test cli_smoke urls_extracts_recent_sanitized_scrollback_links",
        "cargo test --test cli_smoke urls_empty_results_are_machine_friendly",
        "python3 scripts/check_url_contract_policy.py --self-test"
      ],
      "docs_owner": "docs/public-contract.md",
      "classification": "stable",
      "raw_stream_policy": "sanitized-output-only",
      "stability_scope": "Urls is a sanitized scrollback report surface. It scans the last --tail sanitized lines, never attaches to or rewrites the raw PTY stream, prints stable numbered text rows by default, and emits a stable JSON string array for --json. Extraction matches http:// and https:// schemes ASCII-case-insensitively while preserving the original URL text. Text and JSON consume the same extracted URL set: first-seen exact-text deduplicated unique ASCII URL tokens capped at 256 rows, complete raw URL candidates longer than 4096 bytes skipped before trimming instead of truncated, and whitespace/control-bearing or non-ASCII tokens excluded. --last emits the newest valid within-length URL occurrence in the captured tail, even if that occurrence is a duplicate or appears after the 256-row unique-list cap; --last --json emits [] or a one-element array. Empty text modes produce no rows; empty JSON mode produces []. Extracted URLs are untrusted terminal output and may include phishing links or short-lived authentication secrets; automation should treat URL rows as sensitive and avoid logging them verbatim by default.",
      "json_samples": [
        {
          "setup": [
            [
              "start",
              "-d",
              "-n",
              "schema-urls",
              "--",
              "sh",
              "-lc",
              "printf 'SCHEMA_URL https://schema.example/ok\\nSCHEMA_URL_READY\\n'; sleep 5"
            ],
            [
              "wait",
              "schema-urls",
              "--contains",
              "SCHEMA_URL_READY",
              "--timeout",
              "5s"
            ]
          ],
          "argv": [
            "urls",
            "schema-urls",
            "--json"
          ]
        }
      ]
    },
