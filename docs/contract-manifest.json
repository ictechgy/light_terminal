      "stability_scope": "Search is a sanitized scrollback report surface. It scans the last --tail sanitized lines, defaults to --tail 120, never attaches to or rewrites the raw PTY stream, and performs case-sensitive literal line matching. Text output is stable 1-based numbered rows as N<TAB>LINE in capture order. --json emits the same matching sanitized line strings as a JSON array. Empty text mode produces no rows; empty JSON mode produces []. Matching lines are untrusted terminal output and are sanitized before matching and rendering.",
      "json_samples": [
        {
          "setup": [
            [
              "start",
              "-d",
              "-n",
              "schema-search",
              "--",
              "sh",
              "-lc",
              "printf 'SCHEMA_SEARCH needle\\nSCHEMA_SEARCH_READY\\n'; sleep 5"
            ],
            [
              "wait",
              "schema-search",
              "--contains",
              "SCHEMA_SEARCH_READY",
              "--timeout",
              "5s"
            ]
          ],
          "argv": [
            "search",
            "schema-search",
            "needle",
            "--json"
          ]
        }
      ]
