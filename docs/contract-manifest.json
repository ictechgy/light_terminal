      "schema_path": "docs/schemas/urls.schema.json",
      "tests": [
        "cargo test --bin lterm urls_parses_flags_and_validates_tail",
        "cargo test --bin lterm urls_last_json_selection_is_zero_or_one_item_after_unique_cap",
