{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file://docs/schemas/contract-manifest.schema.json",
  "title": "Lterm contract manifest",
  "description": "Compatibility schema for legacy and workstream-1 manifest shapes.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "version",
        "protocol_version",
        "schema_version",
        "commands"
      ],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "protocol_version": { "type": "integer", "minimum": 1 },
        "schema_version": { "type": "string" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "raw_stream_policy", "surface_contracts"],
            "properties": {
              "name": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "raw_stream_policy": { "type": "string", "enum": ["raw", "proxied", "none"] },
              "surface_contracts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^docs/schemas/[a-z_\\.-]+\\.schema\\.json$"
                },
                "minItems": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "type": "string" },
        "release": { "type": "string" },
        "policy": { "type": "object" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "classification", "raw_stream_policy"],
            "properties": {
              "command": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "classification": { "type": "string" },
              "raw_stream_policy": { "type": "string" },
              "schema_path": { "type": ["string", "null"] },
              "surface_contracts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "classification", "raw_stream_policy"],
                  "properties": {
                    "name": { "type": "string" },
                    "classification": { "type": "string" },
                    "raw_stream_policy": { "type": "string" },
                    "schema_path": { "type": ["string", "null"] }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
