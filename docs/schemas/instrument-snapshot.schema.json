{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lterm instrument TARGET --json output",
  "type": "object",
  "required": [
    "schema_version",
    "observed_unix_ms",
    "session_id",
    "pane_id",
    "alive",
    "output_closed",
    "output_revision",
    "output_total_bytes",
    "attached_clients",
    "rows",
    "cols"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observed_unix_ms": { "type": "integer", "minimum": 0 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "pane_id": { "type": "string", "pattern": "^%[0-9]+$" },
    "alive": { "type": "boolean" },
    "output_closed": { "type": "boolean" },
    "output_revision": { "type": "integer", "minimum": 0 },
    "output_total_bytes": { "type": "integer", "minimum": 0 },
    "attached_clients": { "type": "integer", "minimum": 0 },
    "rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }
  },
  "additionalProperties": false
}
