{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lterm doctor --json output",
  "type": "object",
  "required": [
    "client_version",
    "client_protocol_version",
    "daemon_reachable",
    "daemon_version",
    "daemon_protocol_version",
    "version_match",
    "daemon_session_count",
    "daemon_active_connections",
    "daemon_shutting_down",
    "daemon_error",
    "runtime_dir",
    "data_dir",
    "socket_path",
    "shim_dir",
    "tmux_shim_path",
    "tmux_shim_exists",
    "shim_dir_in_path",
    "tmux_compat"
  ],
  "properties": {
    "client_version": {
      "type": "string",
      "minLength": 1
    },
    "client_protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "daemon_reachable": {
      "type": "boolean"
    },
    "daemon_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "daemon_protocol_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "version_match": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "daemon_session_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "daemon_active_connections": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "daemon_shutting_down": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "daemon_uid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "daemon_started_at_unix_secs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "daemon_uptime_secs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "daemon_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "runtime_dir": {
      "type": "string"
    },
    "data_dir": {
      "type": "string"
    },
    "socket_path": {
      "type": "string"
    },
    "shim_dir": {
      "type": "string"
    },
    "tmux_shim_path": {
      "type": "string"
    },
    "tmux_shim_exists": {
      "type": "boolean"
    },
    "shim_dir_in_path": {
      "type": "boolean"
    },
    "tmux_compat": {
      "type": "object",
      "required": [
        "supported_command_count",
        "full_command_count",
        "partial_command_count",
        "noop_command_count",
        "known_gap_count",
        "tmux_shim_exists",
        "shim_dir_in_path",
        "path_tmux_resolves_to_lterm_shim",
        "lterm_shim_precedes_other_tmux",
        "shadowed_real_tmux"
      ],
      "properties": {
        "supported_command_count": {
          "type": "integer",
          "minimum": 1
        },
        "full_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "noop_command_count": {
          "type": "integer",
          "minimum": 0
        },
        "known_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "tmux_shim_exists": {
          "type": "boolean"
        },
        "shim_dir_in_path": {
          "type": "boolean"
        },
        "path_tmux_resolves_to_lterm_shim": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lterm_shim_precedes_other_tmux": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "shadowed_real_tmux": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
