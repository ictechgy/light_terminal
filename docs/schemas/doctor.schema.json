{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lterm doctor --json output",
  "type": "object",
  "required": [
    "client_version",
    "client_protocol_version",
    "daemon_reachable",
    "daemon_version",
    "daemon_protocol_version",
    "version_match",
    "daemon_session_count",
    "daemon_active_connections",
    "daemon_shutting_down",
    "daemon_error",
    "runtime_dir",
    "data_dir",
    "socket_path",
    "shim_dir",
    "tmux_shim_path",
    "tmux_shim_exists",
    "shim_dir_in_path"
  ],
  "properties": {
    "client_version": { "type": "string", "minLength": 1 },
    "client_protocol_version": { "type": "integer", "minimum": 1 },
    "daemon_reachable": { "type": "boolean" },
    "daemon_version": { "type": ["string", "null"] },
    "daemon_protocol_version": { "type": ["integer", "null"], "minimum": 1 },
    "version_match": { "type": ["boolean", "null"] },
    "daemon_session_count": { "type": ["integer", "null"], "minimum": 0 },
    "daemon_active_connections": { "type": ["integer", "null"], "minimum": 0 },
    "daemon_shutting_down": { "type": ["boolean", "null"] },
    "daemon_uid": { "type": ["integer", "null"], "minimum": 0 },
    "daemon_started_at_unix_secs": { "type": ["integer", "null"], "minimum": 0 },
    "daemon_uptime_secs": { "type": ["integer", "null"], "minimum": 0 },
    "daemon_error": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "runtime_dir": { "type": "string" },
    "data_dir": { "type": "string" },
    "socket_path": { "type": "string" },
    "shim_dir": { "type": "string" },
    "tmux_shim_path": { "type": "string" },
    "tmux_shim_exists": { "type": "boolean" },
    "shim_dir_in_path": { "type": "boolean" }
  },
  "additionalProperties": false
}
